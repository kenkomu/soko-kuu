# Copy to /etc/sokokuu/runner.env, then: chmod 600 /etc/sokokuu/runner.env
# systemd format: KEY=value, one per line, no quotes, no trailing comments (comments go on their own line).
# NO secret values belong in this template. The relayer key is a FILE, only its path is set here.

MODE=testnet
PORT=8787
# The runner binds BIND_ADDR:PORT. In testnet mode the default is 127.0.0.1 (loopback): only nginx on this host reaches it.
# Do not set 0.0.0.0 here. Keep the port closed in the firewall as well.
BIND_ADDR=127.0.0.1
# If another service (docker) already uses 8787, pick a free port here AND in the nginx proxy_pass lines.
CHAIN_ID=testnet
CONTRACT_ID=sokokuu.sokokuu-ken.testnet
# Must equal the seed the contract was initialised with (it is 1).
DEMO_SEED=1

RELAYER_ACCOUNT_ID=relayer.sokokuu-ken.testnet
RELAYER_KEY_FILE=/etc/sokokuu/relayer.key
NEAR_RPC_URL=https://rpc.testnet.near.org
GAS_TGAS=100
# The relayer pays gas. /v1/health shows an alarm below this many NEAR.
MIN_BALANCE_NEAR=0.5

# Exact GitHub Pages origin: scheme + host, no path, no trailing slash. Comma separated for several.
# http://localhost and 127.0.0.1 (any port) are always allowed by the runner, so they need no entry here.
# PLACEHOLDER: replace YOURUSER with the real GitHub user or org before starting. The runner refuses nothing at start, so a
# wrong value only shows up as CORS errors in the browser.
CORS_ORIGINS=https://YOURUSER.github.io

# Secret for POST /v1/admin/advance and /v1/admin/pause. Generate: openssl rand -hex 24  (paste it on the server only)
ADMIN_TOKEN=
# Seconds per game phase (dawn, midday, dusk). 0 = clock only by hand through the admin endpoint.
PHASE_SECS=600

# Runner-only state (ledger history, hashed email bindings, guests that have not acted, pending login links, counters).
# Written atomically every second when it changed, file mode 600. Must be on persistent disk; back it up if you care.
DATA_DIR=/var/lib/sokokuu

# Behind nginx on the same host (nginx appends the real client address to X-Forwarded-For).
TRUST_PROXY=1
IP_RPM=120
EMAILS_PER_HOUR=3
MAX_NEW_ACCOUNTS_PER_DAY=100
EVENTS_WAIT_MS=25000
LLM_PROVIDER=none
# Magic-link email: POST {to,subject,text} to this webhook. Empty = links are only logged (guest login still works).
MAIL_WEBHOOK_URL=
PUBLIC_CONFIRM_URL=https://YOURUSER.github.io/REPO/#/confirm?token=
# Never set to 1 in production.
DEV_RETURN_TOKEN=0
