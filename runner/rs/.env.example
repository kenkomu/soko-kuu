# All config via env vars. Never commit real values (.env is git-ignored).
MODE=demo                     # demo | testnet (testnet falls back to demo if the relayer or chain is unavailable)
PORT=8787
CHAIN_ID=testnet
CONTRACT_ID=sokokuu.testnet
DEMO_SEED=42
# Exact origins, comma separated (e.g. https://YOURUSER.github.io). localhost is always allowed for dev.
CORS_ORIGINS=
LLM_PROVIDER=none             # none = fixed voice lines. An LLM may only ever write voice text.

# Clock (the relayer owns it)
PHASE_SECS=0                  # >0: advance one phase every N seconds (demo and testnet)
ADVANCE_COOLDOWN_MS=1500      # demo only: per-player cooldown when players move the clock
ADMIN_TOKEN=                  # secret for POST /v1/admin/advance and /v1/admin/pause; unset disables admin

# Limits (defaults shown)
IP_RPM=120                    # requests per minute per IP
TRUST_PROXY=0                 # 1: take the client IP from the last X-Forwarded-For entry (behind a trusted proxy)
EMAILS_PER_HOUR=3             # magic-link emails per address per hour
MAX_NEW_ACCOUNTS_PER_DAY=100  # new guests + verified players per UTC day
EVENTS_WAIT_MS=25000          # /v1/events long-poll length

# Runner-only state directory (testnet; default ./data, git-ignored): state.json, mode 600, atomic writes
DATA_DIR=

# testnet only
RELAYER_ACCOUNT_ID=
RELAYER_KEY_FILE=             # PATH to a file (outside the repo, chmod 600) holding ed25519:... or a near-cli credentials JSON
RELAYER_PRIVATE_KEY=          # fallback: the key value itself, only from a host secret store; prefer RELAYER_KEY_FILE
NEAR_RPC_URL=https://rpc.testnet.near.org
GAS_TGAS=100                  # gas cap per relayed call (max 300)
MIN_BALANCE_NEAR=0.5            # balance alarm threshold (NEAR)

# email (magic link). Unset => the link is logged to stdout (dev)
MAIL_WEBHOOK_URL=
PUBLIC_CONFIRM_URL=http://localhost:8080/#/confirm?token=
DEV_RETURN_TOKEN=0            # 1 returns the token in /register (demo mode only)
